{% comment %}
  Custom Cursor Loader - Theme App Extension Block
  
  This app embed block loads custom cursor functionality on the storefront.
  It fetches cursor configuration from the app's API and injects CSS styles.
  
  Features:
  - Fetches cursor data from API endpoint
  - Injects custom cursor CSS
  - Supports default and hover cursor states
  - Respects merchant enable/disable settings
  - Mobile-friendly (can be disabled on mobile)
  
  Learn more: https://shopify.dev/docs/apps/online-store/theme-app-extensions
{% endcomment %}

{% liquid
  # Get the shop domain for API request
  assign shop_domain = shop.permanent_domain
  
  # Check if custom cursor should be enabled
  assign enable_cursor = block.settings.enable_cursor
  
  # Check if cursor should be disabled on mobile
  assign disable_on_mobile = block.settings.disable_on_mobile
%}

{% if enable_cursor %}
  <div id="custom-cursor-app" data-shop="{{ shop_domain }}" data-disable-mobile="{{ disable_on_mobile }}">
    {% comment %} Cursor styles and JavaScript will be injected here {% endcomment %}
    
    <script>
      (function() {
        'use strict';
        
        // Configuration
        const shopDomain = '{{ shop_domain }}';
        const disableOnMobile = {{ disable_on_mobile }};
        
        // Check if on mobile device
        function isMobileDevice() {
          return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        }
        
        // Exit early if disabled on mobile
        if (disableOnMobile && isMobileDevice()) {
          console.log('[Custom Cursor] Disabled on mobile devices');
          return;
        }
        
        // Fetch cursor data from API
        const apiUrl = `/api/cursor-data?shop=${encodeURIComponent(shopDomain)}`;
        
        fetch(apiUrl)
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
          })
          .then(data => {
            // Check if cursor is enabled and data is valid
            if (!data.success || !data.data || !data.data.isEnabled) {
              console.log('[Custom Cursor] Cursor not enabled or no data available');
              return;
            }
            
            const cursorData = data.data;
            
            // Generate CSS for cursor (placeholder - will use cursorStyleGenerator in Phase 4)
            if (cursorData.cursor) {
              const cursor = cursorData.cursor;
              const cssCode = `
                /* Custom Cursor Styles */
                :root {
                  --cursor-size: ${cursor.size || 100};
                }
                
                *, *::before, *::after {
                  cursor: url('${cursor.imageUrl}') ${cursor.hotspotX || 0} ${cursor.hotspotY || 0}, auto !important;
                }
                
                html, body {
                  cursor: url('${cursor.imageUrl}') ${cursor.hotspotX || 0} ${cursor.hotspotY || 0}, auto !important;
                }
                
                ${cursor.hoverImageUrl ? `
                /* Hover state cursor */
                a:hover,
                button:hover,
                [role="button"]:hover,
                input[type="submit"]:hover,
                input[type="button"]:hover,
                select:hover,
                .button:hover,
                .btn:hover {
                  cursor: url('${cursor.hoverImageUrl}') ${cursor.hotspotX || 0} ${cursor.hotspotY || 0}, auto !important;
                }
                ` : ''}
              `;
              
              // Inject CSS into page
              const styleElement = document.createElement('style');
              styleElement.id = 'custom-cursor-styles';
              styleElement.textContent = cssCode;
              document.head.appendChild(styleElement);
              
              console.log('[Custom Cursor] Cursor styles applied successfully');
            }
          })
          .catch(error => {
            console.error('[Custom Cursor] Failed to load cursor:', error);
          });
      })();
    </script>
  </div>
{% else %}
  {% comment %} Cursor is disabled - render nothing {% endcomment %}
{% endif %}

{% schema %}
{
  "name": "Custom Cursor",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cursor",
      "label": "Enable Custom Cursor",
      "default": true,
      "info": "Toggle to enable or disable custom cursor on your storefront"
    },
    {
      "type": "checkbox",
      "id": "disable_on_mobile",
      "label": "Disable on Mobile",
      "default": true,
      "info": "Disable custom cursor on mobile devices for better UX"
    },
    {
      "type": "paragraph",
      "content": "Manage your custom cursor settings in the app dashboard. Changes will be reflected automatically on your storefront."
    }
  ]
}
{% endschema %}

