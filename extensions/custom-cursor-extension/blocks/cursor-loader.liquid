{% comment %}
  Custom Cursor Loader - Theme App Extension Block
  
  This app embed block loads custom cursor functionality on the storefront.
  It fetches cursor configuration from the app's API and injects CSS styles.
  
  Features:
  - Loads external JavaScript modules (cursor-style-generator.js, cursor-loader.js)
  - Fetches cursor data from API endpoint
  - Injects custom cursor CSS
  - Supports default and hover cursor states
  - Respects merchant enable/disable settings
  - Mobile detection and smart disabling
  
  Learn more: https://shopify.dev/docs/apps/online-store/theme-app-extensions
{% endcomment %}

{% liquid
  # Get the shop domain for API request
  assign shop_domain = shop.permanent_domain
  
  # Check if custom cursor should be enabled
  assign enable_cursor = block.settings.enable_cursor
  
  # Check if cursor should be disabled on mobile
  assign disable_on_mobile = block.settings.disable_on_mobile
%}

{% if enable_cursor %}
  <div id="custom-cursor-app" 
       data-shop="{{ shop_domain }}" 
       data-disable-mobile="{{ disable_on_mobile }}"
       data-cursor-loader-version="1.1.0">
    {% comment %} Cursor functionality loaded via external JavaScript {% endcomment %}
  </div>

  {% comment %} Load external JavaScript modules {% endcomment %}
  
  {% comment %} 1. Load CSS Generator (must load first) {% endcomment %}
  <script src="{{ 'cursor-style-generator.js' | asset_url }}" defer></script>
  
  {% comment %} 2. Load Cursor Loader (depends on CSS Generator) {% endcomment %}
  <script src="{{ 'cursor-loader.js' | asset_url }}" defer></script>
  
  {% comment %} 3. Initialize cursor loader with configuration {% endcomment %}
  <script>
    (function() {
      'use strict';
      
      // Configuration from Liquid
      var config = {
        shopDomain: '{{ shop_domain }}',
        disableOnMobile: {{ disable_on_mobile | json }}
      };
      
      // Wait for external scripts to load
      function initializeCursor() {
        // Check if dependencies are loaded
        if (typeof window.CustomCursorLoader === 'undefined') {
          console.warn('[Custom Cursor] Loader not yet available, retrying...');
          setTimeout(initializeCursor, 100);
          return;
        }
        
        // Initialize cursor with configuration
        window.CustomCursorLoader.init(config);
      }
      
      // Start initialization when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeCursor);
      } else {
        initializeCursor();
      }
    })();
  </script>
{% else %}
  {% comment %} Cursor is disabled - render nothing {% endcomment %}
{% endif %}

{% schema %}
{
  "name": "Custom Cursor",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cursor",
      "label": "Enable Custom Cursor",
      "default": true,
      "info": "Toggle to enable or disable custom cursor on your storefront"
    },
    {
      "type": "checkbox",
      "id": "disable_on_mobile",
      "label": "Disable on Mobile Devices",
      "default": true,
      "info": "Automatically disable custom cursor on mobile and tablet devices for better user experience"
    },
    {
      "type": "paragraph",
      "content": "Manage your custom cursor from the app admin panel. Select different cursor styles, adjust size, and control hover effects. Changes sync automatically with your storefront."
    }
  ]
}
{% endschema %}

